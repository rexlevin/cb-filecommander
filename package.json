{
    "name": "filecommander",
    "displayName": "FileCommander",
    "id": "com.github.rexlevin.cb-filecommander",
    "private": true,
    "version": "0.1.3",
    "description": "FileCommander - 双栏多标签轻量文件管理器",
    "author": "rexlevin",
    "license": "Apache-2.0",
    "homepage": "https://github.com/rexlevin/cb-filecommander",
    "logo": "public/logo.png",
    "main": "main.js",
    "keywords": ["file-manager", "dual-pane", "utility"],
    "platforms": ["linux", "windows"],
    "scripts": {
        "dev": "vite --port 5182",
        "build": "vite build",
        "preview": "vite preview",
        "dist": "electron-builder --linux dir",
        "start": "cross-env NODE_ENV=development electron -r ../canbox-core/injection.js . --app-id=cb-filecommander --no-sandbox"
    },
    "devDependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@vitejs/plugin-vue": "^6.0.0",
        "cross-env": "^10.1.0",
        "electron": "42.5.1",
        "electron-builder": "^26.0.12",
        "element-plus": "^2.13.1",
        "pinia": "^3.0.3",
        "unplugin-vue-components": "^29.2.0",
        "vite": "^7.0.0",
        "vue": "^3.5.17",
        "vue-i18n": "^11.2.8"
    },
    "build": {
        "appId": "com.github.rexlevin.cb-filecommander",
        "directories": { "output": "dist" },
        "files": [
            "main.js",
            "preload.js",
            "lib/**/*",
            "build/**/*",
            "public/**/*",
            "package.json"
        ],
        "linux": { "target": ["dir"] }
    }
}
